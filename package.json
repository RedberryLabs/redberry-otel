{
  "name": "@redberrylabs/otel",
  "version": "0.4.0",
  "description": "Send AI agent traces to your Redberry installation (OTLP over HTTP to the ingest service in your own cloud): an OpenTelemetry exporter for Vercel, AWS Lambda and Azure Functions.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./init": {
      "import": {
        "types": "./dist/init.d.ts",
        "default": "./dist/init.js"
      },
      "require": {
        "types": "./dist/init.d.cts",
        "default": "./dist/init.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "SPEC.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && tsc --noEmit",
    "vectors": "tsx scripts/make-vectors.ts"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.2",
    "fflate": "0.8.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.0.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@vercel/blob": "^2.8.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/context-async-hooks": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@vercel/blob": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/node": "^22.20.5",
    "@vercel/blob": "^2.8.2",
    "canonicalize": "^5.1.0",
    "eslint": "^10.13.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RedberryLabs/redberry-otel.git"
  },
  "homepage": "https://github.com/RedberryLabs/redberry-otel#readme",
  "bugs": {
    "url": "https://github.com/RedberryLabs/redberry-otel/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
